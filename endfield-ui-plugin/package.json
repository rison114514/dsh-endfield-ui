{
  "name": "@rison/dsh-endfield-ui",
  "version": "0.5.0",
  "description": "Endfield-inspired industrial UI shell for DeepSeek Harness (non-official fan theme)",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "files": [
    "README.md",
    "assets",
    "client.js",
    "cordis.patch.yml",
    "index.js",
    "theme.css"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "theme",
    "web-ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rison114514/dsh-endfield-ui.git"
  },
  "bugs": {
    "url": "https://github.com/rison114514/dsh-endfield-ui/issues"
  },
  "homepage": "https://github.com/rison114514/dsh-endfield-ui#readme",
  "license": "MIT"
}
